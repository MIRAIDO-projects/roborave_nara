---
const currentYear = new Date().getFullYear();
---

<footer class="bg-blue-950 text-white border-t border-blue-900">
    <!-- Related Organizations Section -->
    <section class="bg-gray-100 py-16 text-gray-900">
        <div class="container mx-auto px-4">
            <h3
                class="text-center text-slate-400 font-bold tracking-widest mb-10 uppercase text-sm"
            >
                Related Organizations
            </h3>
            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto"
            >
                <a
                    href="https://www.roborave.org"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center justify-center p-8 bg-white rounded-2xl border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-y-1 hover:shadow-none transition-all duration-200"
                >
                    <div
                        class="text-center w-full h-24 flex items-center justify-center"
                    >
                        <img
                            src="/assets/roborave_international_logo.jpg"
                            alt="RoboRAVE International"
                            class="max-w-full max-h-full object-contain transition-all duration-300"
                        />
                    </div>
                </a>

                <a
                    href="https://roborave-osaka.org"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center justify-center p-8 bg-white rounded-2xl border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-y-1 hover:shadow-none transition-all duration-200"
                >
                    <div
                        class="text-center w-full h-24 flex items-center justify-center"
                    >
                        <img
                            src="/assets/roborave_osaka_logo.jpg"
                            alt="RoboRAVE Osaka"
                            class="max-w-full max-h-full object-contain transition-all duration-300"
                        />
                    </div>
                </a>

                <a
                    href="https://roborave-mie.org"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center justify-center p-8 bg-white rounded-2xl border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-y-1 hover:shadow-none transition-all duration-200"
                >
                    <div
                        class="text-center w-full h-24 flex items-center justify-center"
                    >
                        <img
                            src="/assets/roborave_mie_logo.jpg"
                            alt="RoboRAVE Mie"
                            class="max-w-full max-h-full object-contain transition-all duration-300"
                        />
                    </div>
                </a>

                <a
                    href="https://www.roborave-kaga.com/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center justify-center p-8 bg-white rounded-2xl border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-y-1 hover:shadow-none transition-all duration-200"
                >
                    <div
                        class="text-center w-full h-24 flex items-center justify-center"
                    >
                        <img
                            src="/assets/roborave_kaga_logo.jpg"
                            alt="RoboRAVE Kaga"
                            class="max-w-full max-h-full object-contain transition-all duration-300"
                        />
                    </div>
                </a>

                <a
                    href="#"
                    class="group flex items-center justify-center p-8 bg-white rounded-2xl border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-y-1 hover:shadow-none transition-all duration-200"
                >
                    <div
                        class="text-center w-full h-24 flex items-center justify-center"
                    >
                        <img
                            src="/assets/roborave_tokyo_logo.jpg"
                            alt="RoboRAVE Tokyo"
                            class="max-w-full max-h-full object-contain transition-all duration-300"
                        />
                    </div>
                </a>

                <a
                    href="#"
                    class="group flex items-center justify-center p-8 bg-white rounded-2xl border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:translate-y-1 hover:shadow-none transition-all duration-200"
                >
                    <div
                        class="text-center w-full h-24 flex items-center justify-center"
                    >
                        <img
                            src="/assets/roborave_kobe_logo.jpg"
                            alt="RoboRAVE Kobe"
                            class="max-w-full max-h-full object-contain transition-all duration-300"
                        />
                    </div>
                </a>
            </div>
        </div>
    </section>

    <div class="container mx-auto px-4 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
            <div class="col-span-1 md:col-span-2">
                <h3 class="text-2xl font-bold font-mono mb-4 text-white">
                    RoboRAVE <span class="text-orange-500">Nara</span>
                </h3>
                <p class="text-gray-300 max-w-sm">
                    好奇心に火をつけろ。未来を創れ。<br
                    />若きイノベーターたちのための国際的なステージ。
                </p>
            </div>
            <div>
                <h4
                    class="font-bold mb-4 uppercase tracking-widest text-sm text-orange-500"
                >
                    リンク
                </h4>
                <ul class="space-y-2 text-gray-300">
                    <li>
                        <a
                            href="/#competitions"
                            class="hover:text-white hover:text-orange-400 transition-colors"
                            >競技カテゴリー</a
                        >
                    </li>
                    <li>
                        <a
                            href="/#news"
                            class="hover:text-white hover:text-orange-400 transition-colors"
                            >ニュース</a
                        >
                    </li>
                    <li>
                        <a
                            href="/#workshop"
                            class="hover:text-white hover:text-orange-400 transition-colors"
                            >講習会</a
                        >
                    </li>
                    <li>
                        <a
                            href="/contact"
                            class="hover:text-white hover:text-orange-400 transition-colors"
                            >Contact</a
                        >
                    </li>
                </ul>
            </div>
            <div>
                <h4
                    class="font-bold mb-4 uppercase tracking-widest text-sm text-orange-500"
                >
                    Legal
                </h4>
                <ul class="space-y-2 text-gray-300">
                    <li>
                        <a
                            href="/privacy-policy"
                            class="hover:text-white hover:text-orange-400 transition-colors"
                            >Privacy Policy</a
                        >
                    </li>
                    <li>
                        <a
                            href="/terms-of-use"
                            class="hover:text-white hover:text-orange-400 transition-colors"
                            >Terms of Use</a
                        >
                    </li>
                </ul>
            </div>
        </div>
        <div
            class="border-t border-blue-900 pt-8 flex flex-col md:flex-row justify-between items-center"
        >
            <p class="text-gray-400 text-sm">
                &copy; {currentYear} RoboRAVE Nara. All rights reserved.
            </p>
            <div class="flex space-x-4 mt-4 md:mt-0">
                <!-- Social Icons placeholders -->
            </div>
        </div>
    </div>
</footer>

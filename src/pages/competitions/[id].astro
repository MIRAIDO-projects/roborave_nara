---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { competitions } from "../../data/competitions";

export function getStaticPaths() {
    return competitions.map((comp) => ({
        params: { id: comp.id },
        props: { competition: comp },
    }));
}

const { competition } = Astro.props;
---

<Layout title={`${competition.title} | RoboRAVE Nara`}>
    <Header />

    <main
        class="bg-white min-h-screen text-gray-900 pt-24 selection:bg-orange-500 selection:text-white"
    >
        <!-- Hero Section -->
        <section class="relative py-20 overflow-hidden">
            <div class="absolute inset-0 z-0">
                <div
                    class="absolute inset-0 bg-gradient-to-b from-blue-50 to-white"
                >
                </div>
                <!-- Background Image Blur -->
                <div
                    class="absolute inset-0 bg-cover bg-center blur-3xl opacity-20"
                    style={`background-image: url('${competition.image}');`}
                >
                </div>
            </div>

            <div class="container mx-auto px-4 relative z-10 text-center">
                <span
                    class="inline-block py-1 px-3 border border-blue-600 rounded-full text-blue-600 text-sm font-bold tracking-widest mb-6"
                >
                    CHALLENGE
                </span>
                <h1 class="text-5xl md:text-7xl font-bold mb-6 text-blue-900">
                    {competition.title}
                </h1>
                <p
                    class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed"
                >
                    {competition.description}
                </p>
            </div>
        </section>

        <!-- Details Grid -->
        <section class="py-16">
            <div class="container mx-auto px-4">
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
                >
                    <!-- Rules Card -->
                    <div
                        class="bg-white border border-gray-200 rounded-3xl p-8 shadow-sm hover:shadow-xl hover:border-blue-500/50 transition-all"
                    >
                        <h3
                            class="text-2xl font-bold mb-4 flex items-center text-gray-900"
                        >
                            <span
                                class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center mr-3 text-blue-600"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-5 w-5"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                                    ></path>
                                </svg>
                            </span>
                            ルール・規定
                        </h3>
                        <p class="text-gray-600 mb-6">
                            {competition.title} の公式ルールです。参加前に必ずお読みください。
                        </p>
                        <a
                            href="#"
                            class="text-blue-600 hover:text-orange-500 font-bold inline-flex items-center transition-colors"
                        >
                            PDFをダウンロード <span class="ml-2">&rarr;</span>
                        </a>
                    </div>

                    <!-- Scoring Card -->
                    <div
                        class="bg-white border border-gray-200 rounded-3xl p-8 shadow-sm hover:shadow-xl hover:border-orange-500/50 transition-all"
                    >
                        <h3
                            class="text-2xl font-bold mb-4 flex items-center text-gray-900"
                        >
                            <span
                                class="w-8 h-8 rounded-full bg-orange-100 flex items-center justify-center mr-3 text-orange-600"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-5 w-5"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                                    ></path>
                                </svg>
                            </span>
                            採点方法
                        </h3>
                        <p class="text-gray-600 mb-6">
                            ロボットのパフォーマンスがどのように評価され、採点されるかを確認しましょう。
                        </p>
                        <ul class="text-gray-600 space-y-2 mb-6">
                            <li>• ポイント制システム</li>
                            <li>• タイムペナルティ</li>
                            <li>• ボーナスチャレンジ</li>
                        </ul>
                    </div>

                    <!-- Schedule Card -->
                    <div
                        class="bg-white border border-gray-200 rounded-3xl p-8 shadow-sm hover:shadow-xl hover:border-green-500/50 transition-all"
                    >
                        <h3
                            class="text-2xl font-bold mb-4 flex items-center text-gray-900"
                        >
                            <span
                                class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center mr-3 text-green-600"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-5 w-5"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                                    ></path>
                                </svg>
                            </span>
                            スケジュール
                        </h3>
                        <ul class="space-y-4">
                            <li class="flex justify-between text-sm">
                                <span class="text-gray-500">09:00 - 10:00</span>
                                <span class="font-bold text-gray-900"
                                    >受付 & 練習</span
                                >
                            </li>
                            <li class="flex justify-between text-sm">
                                <span class="text-gray-500">10:00 - 12:00</span>
                                <span class="font-bold text-gray-900">予選</span
                                >
                            </li>
                            <li class="flex justify-between text-sm">
                                <span class="text-gray-500">13:00 - 15:00</span>
                                <span class="font-bold text-gray-900">決勝</span
                                >
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- Registration CTA -->
        <section class="py-20 text-center">
            <div class="container mx-auto px-4">
                <h2 class="text-3xl md:text-5xl font-bold mb-8">
                    参加する準備はいいですか？
                </h2>
                <a
                    href="/contact?subject=Registration"
                    class="inline-block px-10 py-4 bg-orange-500 text-white font-bold rounded-full hover:bg-orange-600 transition-transform hover:scale-105 shadow-lg"
                >
                    {competition.title} にエントリーする
                </a>
            </div>
        </section>
    </main>
    <Footer />
</Layout>

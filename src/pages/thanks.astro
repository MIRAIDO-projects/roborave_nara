---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Thank You | RoboRAVE Nara">
    <Header />
    <main
        class="min-h-screen bg-black text-white flex flex-col items-center justify-center p-4"
    >
        <div
            class="bg-gray-900 border border-white/10 p-12 rounded-3xl shadow-2xl backdrop-blur-sm max-w-lg w-full text-center relative overflow-hidden"
        >
            <!-- Decorative -->
            <div
                class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-blue-400 to-purple-600"
            >
            </div>

            <div
                class="w-20 h-20 bg-green-500/20 rounded-full flex items-center justify-center mx-auto mb-6"
            >
                <svg
                    class="w-10 h-10 text-green-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
            <h1
                class="text-4xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white to-gray-400 mb-4"
            >
                送信完了
            </h1>
            <p class="text-gray-400 mb-8 leading-relaxed">
                お問い合わせありがとうございます。<br
                />内容を確認の上、担当者よりご連絡させていただきます。
            </p>
            <a
                href="/"
                class="inline-block px-8 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white font-bold rounded-full hover:shadow-lg hover:shadow-blue-500/30 transition-all hover:-translate-y-1"
            >
                ホームに戻る
            </a>
        </div>
    </main>
    <Footer />
</Layout>

---
import { getNews, getNewsDetail } from "../../lib/microcms";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const response = await getNews({ fields: ["id"] });
    return response.contents.map((content: any) => ({
        params: {
            slug: content.id,
        },
    }));
}

const { slug } = Astro.params;
const news = await getNewsDetail(slug as string);

const title = news.title;
const description = news.content.substring(0, 100) + "...";
---

<Layout
    title={title}
    description={description}
    type="article"
    publishDate={news.publishedAt}
    data={news}
>
    <article class="max-w-3xl mx-auto px-4 py-12">
        <header class="mb-8 border-b pb-4">
            <div class="flex items-center gap-4 text-sm text-gray-500 mb-2">
                <time datetime={news.publishedAt}
                    >{new Date(news.publishedAt!).toLocaleDateString()}</time
                >
                <span class="bg-green-100 text-green-800 px-2 py-1 rounded-full"
                    >{news.category?.name}</span
                >
            </div>
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900">
                {title}
            </h1>
        </header>

        <div class="prose prose-lg max-w-none" set:html={news.content} />

        <div class="mt-12 pt-8 border-t border-gray-200">
            <a
                href="/news"
                class="text-blue-600 hover:text-blue-800 transition-colors"
                >&larr; ニュース一覧に戻る</a
            >
        </div>
    </article>
</Layout>

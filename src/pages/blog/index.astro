---
import { getBlogs } from "../../lib/microcms";
import Layout from "../../layouts/Layout.astro";

const response = await getBlogs({
    fields: ["id", "title", "publishedAt", "eyecatch", "category"],
});
const blogs = response.contents;
---

<Layout title="Blog">
    <div class="max-w-4xl mx-auto px-4 py-12">
        <h1 class="text-4xl font-bold mb-8">Blog</h1>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {
                blogs.map((blog) => (
                    <a href={`/blog/${blog.id}`} class="block group">
                        <article class="bg-white rounded-lg shadow-md overflow-hidden transition-transform group-hover:-translate-y-1">
                            {blog.eyecatch && (
                                <img
                                    src={blog.eyecatch.url}
                                    alt={blog.title}
                                    width={blog.eyecatch.width}
                                    height={blog.eyecatch.height}
                                    class="w-full h-48 object-cover"
                                />
                            )}
                            <div class="p-6">
                                <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
                                    <time datetime={blog.publishedAt}>
                                        {new Date(
                                            blog.publishedAt!,
                                        ).toLocaleDateString()}
                                    </time>
                                    <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded-full text-xs">
                                        {blog.category?.name}
                                    </span>
                                </div>
                                <h2 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors">
                                    {blog.title}
                                </h2>
                            </div>
                        </article>
                    </a>
                ))
            }
        </div>
    </div>
</Layout>
